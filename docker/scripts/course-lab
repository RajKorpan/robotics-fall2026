#!/usr/bin/env bash
set -eo pipefail

# New images also pick up launcher fixes from the mounted course checkout.
mounted_launcher=/workspace/docker/scripts/course-lab
if [[ -f "$mounted_launcher" && "$(readlink -f "${BASH_SOURCE[0]}")" != "$(readlink -f "$mounted_launcher")" ]]; then
  exec bash "$mounted_launcher" "$@"
fi

lab="${1:-}"
uses_ros=true
case "$lab" in
  week01_ros_foundations) domain=24 ;;
  week03_motion_frames_ai) domain=25 ;;
  week06_slam_localization) domain=26 ;;
  week08_vision_perception) domain=28 ;;
  week09_planning_navigation) domain=29 ;;
  week10_foundation_models) domain=""; uses_ros=false ;;
  week11_hri_evaluation) domain=31 ;;
  *) echo "Usage: course-lab {week01_ros_foundations|week03_motion_frames_ai|week06_slam_localization|week08_vision_perception|week09_planning_navigation|week10_foundation_models|week11_hri_evaluation}" >&2; exit 2 ;;
esac

root="/workspace/$lab"
setup="$root/ros2_ws/install/setup.bash"
if [[ ! -f "$root/app.py" ]]; then
  echo "The lab guide is missing: $root/app.py. Update the course checkout." >&2
  exit 3
fi
if [[ "$uses_ros" == true && ! -f "$setup" ]]; then
  echo "$lab has not been built. Run course-build-workspaces first." >&2
  exit 3
fi

# Windows Git configurations can leave CRLF endings in an existing clone even
# after the repository begins enforcing LF. Normalize course shell scripts
# before students run them from the bind-mounted workspace.
if [[ -d "$root/scripts" ]]; then
  find "$root/scripts" -type f -name '*.sh' -exec sed -i 's/\r$//' {} +
fi

if [[ "$uses_ros" == true ]]; then
  source /opt/ros/jazzy/setup.bash
  source "$setup"
  export ROS_DOMAIN_ID="$domain"
  export TURTLEBOT3_MODEL=burger
fi
set -u
export COURSE_LAB_RUN_ID="$(date +%s%N)-$$"

active_env=/tmp/course-active-env.sh
printf 'export COURSE_ACTIVE_LAB=%q\n' "$lab" >"$active_env"
printf 'export COURSE_LAB_ROOT=%q\n' "$root" >>"$active_env"
printf 'export COURSE_LAB_RUN_ID=%q\n' "$COURSE_LAB_RUN_ID" >>"$active_env"
if [[ "$uses_ros" == true ]]; then
  printf 'export ROS_DOMAIN_ID=%q\n' "$domain" >>"$active_env"
  printf 'export TURTLEBOT3_MODEL=%q\n' "burger" >>"$active_env"
  printf 'source %q\n' "$setup" >>"$active_env"
fi

pid_file=/tmp/course-streamlit.pid
if [[ -f "$pid_file" ]]; then
  old_pid="$(cat "$pid_file")"
  if kill -0 "$old_pid" 2>/dev/null; then
    kill "$old_pid"
    for _ in $(seq 1 30); do
      kill -0 "$old_pid" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$pid_file"
fi

(
  cd "$root"
  nohup /opt/course-venv/bin/python -m streamlit run app.py \
    --server.address=0.0.0.0 --server.port=8501 --server.headless=true \
    >/tmp/course-streamlit.log 2>&1 &
  echo $! >"$pid_file"
)

streamlit_pid="$(cat "$pid_file")"
guide_ready=false
for _ in $(seq 1 240); do
  if ! kill -0 "$streamlit_pid" 2>/dev/null; then
    echo "The lab guide stopped during startup." >&2
    echo "Streamlit log:" >&2
    cat /tmp/course-streamlit.log >&2
    exit 4
  fi
  if curl --fail --silent --show-error --max-time 1 http://127.0.0.1:8501/ >/dev/null 2>&1; then
    guide_ready=true
    break
  fi
  sleep 0.25
done

if [[ "$guide_ready" != true ]]; then
  echo "The lab guide did not respond on port 8501 within 60 seconds." >&2
  echo "Streamlit log:" >&2
  cat /tmp/course-streamlit.log >&2
  exit 5
fi

if [[ "$uses_ros" == true ]]; then
  DISPLAY="${DISPLAY:-:1}" nohup xterm -display "${DISPLAY:-:1}" -T "$lab" -geometry 120x34+70+70 -e bash -lc \
    "source /usr/local/bin/course-shell-init; cd '$root'; printf '\nActive lab: $lab\nROS_DOMAIN_ID=$domain\n\n'; exec bash" >/tmp/course-xterm.log 2>&1 &
fi

echo "Started $lab and confirmed that the guide is responding."
echo "Guide:  http://localhost:8501"
if [[ "$uses_ros" == true ]]; then
  echo "Desktop: http://localhost:6080/vnc.html?autoconnect=1&resize=remote"
else
  echo "This Python lab runs in the guide. No ROS workspace build is required."
fi
